// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  firstName String?
  lastName  String?
  stripeCustomerId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  submissions Submission[]
  notifications Notification[]
  canCreateCourses Boolean @default(false)
  deleted     Boolean  @default(false)

  passwordResetTokens PasswordResetToken[]
}



model Course {
  id        String   @id @default(cuid())
  name      String
  abbr      String
  studentInviteCode String? @unique
  taInviteCode      String? @unique
  allowNewEnrollments Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  deleted     Boolean  @default(false)

  billingScheme                   BillingScheme
  primaryBillingContactUserId     String?
  primarySystemContactUserId      String?
  primaryTeacherUserId            String?
  hidePaymentInfoFromOtherTeachers Boolean @default(false)
  submissions Submission[]
  assignments Assignment[]
  latePolicyAllowLateSubmissions Boolean @default(true)
  latePolicyMaxLatenessMinutes Int?
  latePolicyPenaltyPercent Float?
  latePolicyPenaltyType LatePenaltyType?
  submissionRetentionMode SubmissionRetentionMode @default(BEST)
}

enum BillingScheme {
  PER_STUDENT
  PER_COURSE
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  type EnrollmentType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  billingFollowUpResolvedAt DateTime?
}

enum EnrollmentType {
  STUDENT
  TEACHER
  TA
}

model Assignment {
  id        String   @id @default(cuid())
  name      String
  description String?

  unitSystem String
  pointsPossible Int
  gradeVisibility GradeVisibility

  volume Float
  surfaceArea Float
  tolerancePercent Float

  dueDate DateTime?
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  submissions Submission[]
  signatures AssignmentSignature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  latePolicyInheritFromCourse Boolean @default(true)
  latePolicyAllowLateSubmissions Boolean?
  latePolicyMaxLatenessMinutes Int?
  latePolicyPenaltyPercent Float?
  latePolicyPenaltyType LatePenaltyType?
  submissionRetentionInheritFromCourse Boolean @default(true)
  submissionRetentionMode SubmissionRetentionMode?
}

enum GradeVisibility {
  INSTANT
  ON_DUE_DATE
}

enum LatePenaltyType {
  FLAT
  PER_DAY
}

enum SubmissionRetentionMode {
  BEST
  MOST_RECENT
}

enum AssignmentSignatureType {
  CORRECT
  INCORRECT
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  volume Float?
  surfaceArea Float?
  fileKey String?
  fileUrl String?
  fileName String?
  screenshotKey String?
  screenshotUrl String?
  featureTree Json?

  grade Float?
  feedback String?
  staffComment String?
  graderErrorCount Int @default(0)
  graderLastError String?
  graderFailedAt DateTime?
  graderFailureNotifiedAt DateTime?
  matchingSignatureId String?
  matchingSignature AssignmentSignature? @relation(fields: [matchingSignatureId], references: [id], onDelete: Cascade)
  unpenalizedGrade Float?
  autoGrade Float?
  manuallyGraded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model AssignmentSignature {
  id        String   @id @default(cuid())
  assignmentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  sortOrder Int
  type AssignmentSignatureType
  unitSystem String
  volume Float
  surfaceArea Float
  centerOfMassX Float?
  centerOfMassY Float?
  centerOfMassZ Float?
  screenshotKey String?
  screenshotUrl String?
  feedback String?
  pointsAwarded Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  submissions Submission[]

  @@unique([assignmentId, sortOrder])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  content   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

enum NotificationType {
  ASSIGNMENT_GRADED
  ASSIGNMENT_POSTED
  PAYMENT_ISSUE
  OTHER
  SIGNATURE_TREND
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
